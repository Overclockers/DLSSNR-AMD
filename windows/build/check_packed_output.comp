#version 460
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,rgba32f) uniform readonly image2D source;
layout(set=0,binding=1,r11f_g11f_b10f) uniform writeonly image2D target;
layout(push_constant) uniform Push {uint w,h;} pc;
void main() {
    ivec2 xy=ivec2(gl_GlobalInvocationID.xy);
    if(xy.x>=int(pc.w)||xy.y>=int(pc.h))return;
    imageStore(target,xy,imageLoad(source,xy));
}
